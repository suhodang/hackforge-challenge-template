# 셸 변수 형식(ADR 014, ADR 020). register.sh와 build.sh가 읽는다
SLUG=example
TITLE="예시: 파일 보기"
MAX_DEFENSE_ATTEMPTS=5
# 분류 키(hackforge-docs ADR 020 분류 목록). 목록에 없는 키는 등록이 거절된다
CATEGORY=path-traversal
# INTRO(입문), BEGINNER(초급), INTERMEDIATE(중급), ADVANCED(고급)
DIFFICULTY=INTRO
# 예상 시간(분, 1 이상 정수)
ESTIMATED_MINUTES=20
# 목록에 보이는 한 줄 요약(80자 이내). 해답을 적지 않는다
SUMMARY="파일 보기 페이지의 취약점을 찾아 공격하고 고치는 예시 문제"
